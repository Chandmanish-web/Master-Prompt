# Local MongoDB (development)
MONGO_URI=mongodb://127.0.0.1:27017/worktrack

# MongoDB Atlas example (production / Render)
# Use the database name and encode special characters in the username.
# Example: mongodb+srv://<username>:<password>@cluster0.mbmtfym.mongodb.net/worktrack?retryWrites=true&w=majority
# If your username contains @, encode it as %40: user%40domain
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mbmtfym.mongodb.net/worktrack?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_here
PORT=5000
CLIENT_URL=http://localhost:5173
