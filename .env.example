# Docker Compose Environment Variables
# Copy this to .env and update with your actual values

# MongoDB Configuration
# For local development:
MONGO_URI=mongodb://mongo:27017/worktrack
# For Atlas (production):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/worktrack?retryWrites=true&w=majority

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-key-in-production

# Environment
NODE_ENV=development

# CORS Configuration
CLIENT_URL=http://localhost:4173

# Vite API URL for frontend
VITE_API_URL=http://localhost:5000/api

# Google Gemini chatbot (server-side only)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
